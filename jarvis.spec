# -*- mode: python ; coding: utf-8 -*-
"""
Jarvis Windows build specification (Step 23 — Phase 8).

Preferred invocation is the repeatable build script:

    python build.py

which runs the tests first and verifies the result afterwards. To
build directly:

    python -m PyInstaller jarvis.spec

Layout produced (PyInstaller 6 one-directory / "onedir" mode):

    dist/Jarvis/Jarvis.exe          console application (Phase 19)
    dist/Jarvis/_internal/          bundled libraries + data files

Why one-directory mode: no per-launch extraction (faster, steadier
startup than one-file mode), a predictable folder to zip and share,
and a real directory for the bundled read-only resources. See
README.md.

Everything in this file is derived from the source tree — no absolute
developer path, no environment-specific value is written into the
build.
"""

import re
import importlib.util
from pathlib import Path

# Directory containing this spec file (provided by PyInstaller).
ROOT = Path(SPECPATH)

# ---------------------------------------------------------------------------
# Version (single source of truth: core/version.py)
# ---------------------------------------------------------------------------


def _read_version() -> str:
    source = (ROOT / "core" / "version.py").read_text(encoding="utf-8")
    match = re.search(r'^VERSION\s*=\s*"([^"]+)"', source, re.MULTILINE)
    if match is None:
        raise SystemExit("jarvis.spec: VERSION not found in core/version.py")
    return match.group(1)


VERSION = _read_version()


def _version_resource() -> str | None:
    """
    Generate a Windows VERSIONINFO resource from core/version.py.

    The generated file lives under build/ (an owned build directory),
    so the executable's Properties dialog shows the same version as
    `Jarvis.exe --version`. Returns None if generation is not possible;
    the build then proceeds without the resource.
    """
    try:
        parts = [int(p) for p in VERSION.split(".")]
    except ValueError:
        return None
    while len(parts) < 4:
        parts.append(0)
    parts = parts[:4]
    tuple_str = f"({parts[0]}, {parts[1]}, {parts[2]}, {parts[3]})"

    content = f"""# UTF-8
# Generated by jarvis.spec from core/version.py — do not edit.
VSVersionInfo(
  ffi=FixedFileInfo(
    filevers={tuple_str},
    prodvers={tuple_str},
    mask=0x3f,
    flags=0x0,
    OS=0x40004,
    fileType=0x1,
    subtype=0x0,
    date=(0, 0)
  ),
  kids=[
    StringFileInfo(
      [
      StringTable(
        '040904b0',
        [StringStruct('CompanyName', 'Jarvis'),
        StringStruct('FileDescription', 'Jarvis command-line assistant'),
        StringStruct('FileVersion', '{VERSION}'),
        StringStruct('InternalName', 'Jarvis'),
        StringStruct('OriginalFilename', 'Jarvis.exe'),
        StringStruct('ProductName', 'Jarvis'),
        StringStruct('ProductVersion', '{VERSION}')])
      ]),
    VarFileInfo([VarStruct('Translation', [1033, 1200])])
  ]
)
"""
    target = ROOT / "build" / "version_info.txt"
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(content, encoding="utf-8")
    return str(target)


# ---------------------------------------------------------------------------
# Bundled data files (read-only application resources)
# ---------------------------------------------------------------------------


def _punkt_tab_dir() -> Path:
    """
    Locate the punkt_tab tokenizer data that ships with the build.

    Only the English model is bundled (the only language Jarvis
    tokenizes) — a few hundred KB instead of ~10 MB for all
    languages. Nothing is downloaded during the build: when the data
    is missing the build stops with the exact command to run once.
    """
    import nltk.data  # build-time only; never imported at application runtime here

    for entry in nltk.data.path:
        if not entry:
            continue
        candidate = Path(entry) / "tokenizers" / "punkt_tab" / "english"
        if candidate.is_dir():
            return candidate.parent  # the punkt_tab folder
    raise SystemExit(
        "jarvis.spec: NLTK tokenizer data 'punkt_tab' not found on this "
        "machine.\nInstall it once, then rebuild:\n"
        "    python -m nltk.downloader punkt_tab"
    )


DATAS = [
    # Default configuration templates (see utils/paths.py).
    (str(ROOT / "config" / "settings.json"), "config"),
    (str(ROOT / "config" / "commands.json"), "config"),
    # Spell-correction model (core/spell_model.py loads it next to itself).
    (str(ROOT / "core" / "spell_model.json"), "core"),
    # ML intent classification dataset (Step 25). Read-only training data,
    # anchored to bundle_dir() (utils/paths.py) so it is found regardless of
    # the current working directory. Bundled so a packaged build can train
    # the model on first run even with no network and no pre-existing model.
    (str(ROOT / "data" / "intent_dataset.csv"), "data"),
    # NLTK data for offline tokenization (Phase 9).
    (str(_punkt_tab_dir() / "english"), "nltk_data/tokenizers/punkt_tab"),
]

# Optional microphone, Windows speech, and local wake components are included
# when their dependencies and wake models are present at build time.
OPTIONAL_HIDDENIMPORTS = []
OPTIONAL_DATAS = []
for optional_module in ("speech_recognition", "pyaudio", "win32com", "pythoncom"):
    if importlib.util.find_spec(optional_module) is not None:
        OPTIONAL_HIDDENIMPORTS.append(optional_module)

if importlib.util.find_spec("win32com") is not None:
    OPTIONAL_HIDDENIMPORTS.extend(["win32com.client", "pywintypes"])

if importlib.util.find_spec("openwakeword") is not None:
    OPTIONAL_HIDDENIMPORTS.extend([
        "openwakeword",
        "openwakeword.model",
        "openwakeword.utils",
        "onnxruntime",
    ])
    import openwakeword

    wake_models_dir = Path(openwakeword.__file__).parent / "resources" / "models"
    for wake_model in wake_models_dir.glob("*.onnx"):
        OPTIONAL_DATAS.append((str(wake_model), "openwakeword/resources/models"))

# ---------------------------------------------------------------------------
# Collection options
# ---------------------------------------------------------------------------

# Packages NLTK references only from try/except ImportError guards
# (verified: tokenization works with all of them unavailable — see the
# packaging report). Excluding them keeps the distribution small and
# startup fast. Jarvis never uses ML, statistics, plotting, or GUI
# toolkits — tkinter is guarded by importlib.util.find_spec() in
# nltk/__init__.py, so excluding it simply skips the optional GUI.
# The Qt bindings are excluded because this machine has several
# installed and PyInstaller refuses to bundle more than one; none of
# them are used by Jarvis.
#
# NOTE: numpy and scipy are NOT excluded because the ML intent
# classifier (Step 25) depends on scikit-learn which requires numpy
# and scipy. They must be bundled for the ML classifier to work.
EXCLUDES = [
    "pandas",
    "pyarrow",
    "matplotlib",
    "tkinter",
    "PyQt5",
    "PyQt6",
    "PySide6",
    "torch",
    "whisper",
    "speech_recognition.recognizers.whisper",
    # The wake model is configured for ONNX inference; these optional
    # openWakeWord training/TFLite runtimes are never used by Jarvis.
    "tensorflow",
    "keras",
    "tensorboard",
    "tflite_runtime",
]

analysis = Analysis(
    ["main.py"],
    pathex=[str(ROOT)],
    binaries=[],
    datas=DATAS + OPTIONAL_DATAS,
    hiddenimports=[
        "numpy", "scipy", "pyttsx3", "pyttsx3.drivers.sapi5",
        "comtypes.client",
    ] + OPTIONAL_HIDDENIMPORTS,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=EXCLUDES,
    noarchive=False,
)

pyz = PYZ(analysis.pure)

exe = EXE(
    pyz,
    analysis.scripts,
    [],
    exclude_binaries=True,
    name="Jarvis",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=True,  # Phase 19: the CLI console must stay visible
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    version=_version_resource(),
)

coll = COLLECT(
    exe,
    analysis.binaries,
    analysis.datas,
    strip=False,
    upx=False,
    name="Jarvis",
)



